    <bf:supplementaryContent>
      <bf:SupplementaryContent>
        <rdfs:label xml:lang="ara">الذريعة الى تصانيف الشيعة، الجزء 17، الصفحه 32، الرقم 183.</rdfs:label>
      </bf:SupplementaryContent>
    </bf:supplementaryContent>

