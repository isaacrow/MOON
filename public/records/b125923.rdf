      <bf:Place rdf:about="http://id.loc.gov/vocabulary/countries/ir">
        <rdfs:label>طهران، ايران (ir)</rdfs:label>
      </bf:Place>
    </bf:originPlace>
    <bf:originPlace>
      <rdf:Description>
        <rdfs:label>طهران، ايران / كربلاء المقدسة</rdfs:label>
      </rdf:Description>
    </bf:originPlace>
    <bf:temporalCoverage>1041-1061 هـ. / القرن 17 الميلادي</bf:temporalCoverage>
