        rdfs:label "مخطوطات"
    ] ;
    bf:summary [
        a bf:Summary ;
        rdfs:label "كتاب فلسفي كلامي للميرداماد يناقش حدوث العالم وقدمه ومسألة الدهر والزمان والمصادر الوجودية وفق الحكمة المتعالية والمشائية."
    ] ;
    bf:tableOfContents [
        a bf:TableOfContents ;
        rdfs:label "مقدمة في حدوث العالم، الومضة الأولى في الوجود والعدم، القبسة الأولى في مراتب الوجود والدهر والسرمد، القبسة الثانية في إثبات الواجب، القبسة الثالثة في الحركة والزمان والآن."
    ] ;
    bf:originDate "1650 [1061 هـ.]" ;
    bf:date "1650" ;
    bf:originPlace [
        a bf:Place ;
        rdfs:label "طهران، ايران (ir)"
    ], [
        rdfs:label "طهران، ايران / كربلاء المقدسة"
    ] ;
    bf:temporalCoverage "1041-1061 هـ. / القرن 17 الميلادي", [
        a moonext:TemporalCoverage ;
        moonext:start "1041 هـ." ;
        moonext:end "1061 هـ. (1650 م.)" ;
        rdfs:label "1041-1061 هـ. / القرن 17 الميلادي"
    ] ;
    bf:note [
        a bf:Note ;
        rdfs:label "أوله : الحمد لله الواحد الاحد الصمد المصمود مهيمن كل وجود وجاعل كل موجود، والصلاة على من اقتفاه من زمرة الانبياء، واصطفاه من رسل الرسل فابتعثه بالذكر..."
    ], [
        a bf:Note ;
        rdfs:label "آخره : ولا تخلنا اللهم مع ذلك من عواطف رأفتك وسوابغ رحمتك ولطايف كفايتك وحوط عنايتك وحسن كلائتك بجودك ومنك وفضلك وطولك يا أرحم الراحمين."
    ], [
        a bf:Note ;
        rdfs:label "الذريعة الى تصانيف الشيعة، الجزء 17، الصفحه 32، الرقم 183."
    ], [
        a bf:Note ;
        rdfs:label "مكتبة مجلس الشورى : 4662، طهران، ايران (ir)"
    ], [
        a bf:Note ;
        rdfs:label "أوله: الحمد لله الواحد الاحد الصمد المصمود مهيمن كل وجود وجاعل كل موجود...\nآخره: ولا تخلنا اللهم مع ذلك من عواطف رأفتك وسوابغ رحمتك ولطايف كفايتك وحوط عنايتك...\nالذريعة الى تصانيف الشيعة: ج 17، ص 32، رقم 183.\nمكتبة مجلس الشورى: 4662، طهران، ايران."
    ] ;
