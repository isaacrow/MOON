      "bf:summary": {
        "@type": "bf:Summary",
        "rdfs:label": "Named inventor of the World Wide Web and director of the W3C, Tim Berners-Lee offers insights into the true nature of the Web, articulating its potential as well as the problems which threaten its existence. Co-author Mark Fischetti provides a context for the development of the Web and helps readers understand its significance."
      },
      "bf:tableOfContents": {
        "@type": "bf:TableOfContents",
        "rdfs:label": "Enquire within upon everything -- Tangles, links, and webs -- info.cern.ch -- Protocols -- Going global -- Browsing -- Changes -- Consortium -- Weaving the Web."
      },
